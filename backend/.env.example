
# ── Database ──────────────────────────────────────────────────
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Strategy ──────────────────────────────────────────────────
SCAN_INTERVAL_MS=60000
DISCOVERY_PAGES=12
DEADLINE_LOOKAHEAD_DAYS=14
ALLOW_POST_DEADLINE_ENTRIES=false
MIN_NO_ENTRY_PRICE=0.92
MAX_NO_ENTRY_PRICE=0.985
MAX_SPREAD=0.03
MIN_LIQUIDITY_NUM=10000
MIN_VOLUME_24H=0
MIN_EXPECTED_NET_PROFIT_USDC=0.1
MAX_SIMULTANEOUS_POSITIONS=5

# ── Risk Guardrails ───────────────────────────────────────────
CONSECUTIVE_LOSS_PAUSE_LIMIT=3
RISK_AUTO_RESUME_ENABLED=false
RISK_AUTO_RESUME_COOLDOWN_MS=300000

# ── Portfolio ─────────────────────────────────────────────────
STARTING_CAPITAL=10

# ── API Server ────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production
ADMIN_PASSWORD=change_me_to_something_secure
