
# ── Database ──────────────────────────────────────────────────
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Portfolio ─────────────────────────────────────────────────
STARTING_CAPITAL=100
ALLOW_NEGATIVE_BALANCE=true

# ── Strategy: scan + entry band ───────────────────────────────
SCAN_INTERVAL_MS=60000
# Band floor keeps us off dust; cap preserves upside so R:R can be positive.
MIN_NO_ENTRY_PRICE=0.75
MAX_NO_ENTRY_PRICE=0.9
MAX_SIMULTANEOUS_POSITIONS=5

# ── Strategy: entry (recovery + risk/reward) ──────────────────
# A genuine recovery = upward momentum over CONFIRM_HOURS off the LOOKBACK low.
ENTRY_DIP_LOOKBACK_HOURS=48
ENTRY_CONFIRM_HOURS=6
ENTRY_REBOUND_EPSILON=0.03
# Require upside/downside (to the risk anchor) of at least this.
ENTRY_MIN_RISK_REWARD=1.1
# Risk anchor = max(STOP_FLOOR, recovery low − RISK_ANCHOR_BUFFER); the R:R reference.
RISK_ANCHOR_BUFFER=0.03

# ── Strategy: exit (hold to resolution; stop only on a collapse to the floor) ─
STOP_ENABLED=true
STOP_FLOOR=0.6

# ── Risk Guardrails ───────────────────────────────────────────
CONSECUTIVE_LOSS_PAUSE_LIMIT=3
RISK_AUTO_RESUME_ENABLED=false
RISK_AUTO_RESUME_COOLDOWN_MS=300000

# ── API Server ────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production
ADMIN_PASSWORD=change_me_to_something_secure

# ── Notifications ─────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
