
# ── Database ──────────────────────────────────────────────────
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Portfolio ─────────────────────────────────────────────────
STARTING_CAPITAL=100
ALLOW_NEGATIVE_BALANCE=true

# ── Strategy: scan + entry band ───────────────────────────────
SCAN_INTERVAL_MS=60000
# Outer sanity bounds only; the recovery gate drives entry.
MIN_NO_ENTRY_PRICE=0.75
MAX_NO_ENTRY_PRICE=0.97
MIN_EXPECTED_NET_PROFIT_USDC=0.1
MAX_SIMULTANEOUS_POSITIONS=5

# ── Strategy: ladder gates ────────────────────────────────────
ENTRY_MIN_CAMPAIGN_AGE_FRACTION=0.3
ENTRY_MIN_BUCKET_DISTANCE=1
# Secondary sanity bounds (YES mass strictly below candidate; modal stability).
ENTRY_MAX_TAIL_YES_MASS=0.25
ENTRY_MIN_MODAL_MARGIN=0.05

# ── Strategy: recovery gate (primary) ─────────────────────────
ENTRY_DIP_LOOKBACK_HOURS=24
ENTRY_DIP_THRESHOLD=0.02
ENTRY_REBOUND_DELTA=0.02
# At/above high-confidence a stable price is enough; below it, entry must sit
# at least ENTRY_MIN_REBOUND_FROM_LOW above the recovery low.
ENTRY_HIGH_CONFIDENCE_NO_PRICE=0.9
ENTRY_MIN_REBOUND_FROM_LOW=0.03

# ── Stop-Loss (context-relative to the recovery low) ──────────
STOP_LOSS_ENABLED=true
STOP_LOSS_BUFFER_BELOW_LOW=0.03
STOP_LOSS_ABSOLUTE_FLOOR=0.6

# ── Risk Guardrails ───────────────────────────────────────────
CONSECUTIVE_LOSS_PAUSE_LIMIT=3
RISK_AUTO_RESUME_ENABLED=false
RISK_AUTO_RESUME_COOLDOWN_MS=300000

# ── API Server ────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production
ADMIN_PASSWORD=change_me_to_something_secure

# ── Notifications ─────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
